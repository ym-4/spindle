{
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.41",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "dotenv -e .env.dev -- node ./src/server.js",
    "seed": "dotenv -e .env.dev -- node scripts/seed.js",
    "migration:reset": "dotenv -e .env.dev -- node scripts/reset.js",
    "test:unit": "jest --testPathPatterns=__tests__/unit --silent",
    "test:integration": "dotenv -e .env.test -- jest --testPathPatterns=__tests__/integration --globalSetup=./configs/jest-integration-setup.js --runInBand --silent",
    "test:e2e": "node scripts/clean-test-results.js && dotenv -e .env.test -- npx playwright test --config=configs/playwright.config.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:trace": "npm run test:e2e -- --reporter=html --trace on",
    "lint": "eslint -c configs/eslint.config.mjs .",
    "lint:fix": "eslint -c configs/eslint.config.mjs . --fix",
    "lint:report": "eslint -c configs/eslint.config.mjs . --format html --output-file reports/eslint-report.html || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format-check": "prettier --check .",
    "report": "node scripts/qa-report.js",
    "dev": "nodemon index.js",
    "prepare": "husky"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/public/**"
    ],
    "coverageDirectory": "coverage-report",
    "maxWorkers": 1
  }
}
